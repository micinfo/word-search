{
  "name": "word-search-games",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start:levopront": "cd packages/levopront && npm start",
    "start:kcab": "cd packages/kcab && npm start",
    "start:suganon": "cd packages/suganon && npm start",
    "start:matchgame": "cd packages/matchgame && npm start",
    "start:memorygame": "cd packages/memorygame && npm start",
    "start:memorygamev2": "cd packages/memorygamev2 && npm start",
    "start:slackscheduler": "cd packages/slack-scheduler && npm start",
    "build:slackscheduler": "cd packages/slack-scheduler && npm run build",
    "build:memorygame": "cd packages/memorygame && npm run build",
    "build:memorygamev2": "cd packages/memorygamev2 && npm run build",
    "build:levopront": "cd packages/levopront && npm run build",
    "build:shared": "cd packages/shared && npm run build",
    "build:kcab": "npm run build:shared && cd packages/kcab && npm run build",
    "build:suganon": "npm run build:shared && cd packages/suganon && npm run build",
    "build:matchgame": "cd packages/matchgame && npm run build",
    "vercel:link:levopront": "cd packages/levopront && npx vercel link",
    "vercel:deploy:levopront": "cd packages/levopront && npx vercel deploy",
    "vercel:deploy:levopront:prod": "cd packages/levopront && npx vercel deploy --prod",
    "vercel:link:kcab": "cd packages/kcab && npx vercel link",
    "vercel:deploy:kcab": "cd packages/kcab && npx vercel deploy",
    "vercel:deploy:kcab:prod": "cd packages/kcab && npx vercel deploy --prod",
    "vercel:link:suganon": "cd packages/suganon && npx vercel link",
    "vercel:deploy:suganon": "cd packages/suganon && npx vercel deploy",
    "vercel:deploy:suganon:prod": "cd packages/suganon && npx vercel deploy --prod",
    "vercel:link:matchgame": "cd packages/matchgame && npx vercel link",
    "vercel:deploy:matchgame": "cd packages/matchgame && npx vercel deploy",
    "vercel:deploy:matchgame:prod": "cd packages/matchgame && npx vercel deploy --prod",
    "vercel:link:memorygame": "cd packages/memorygame && npx vercel link",
    "vercel:deploy:memorygame": "cd packages/memorygame && npx vercel deploy",
    "vercel:deploy:memorygame:prod": "cd packages/memorygame && npx vercel deploy --prod",
    "vercel:link:memorygamev2": "npx vercel link",
    "vercel:deploy:memorygamev2": "cd packages/memorygamev2 && npx vercel deploy",
    "vercel:deploy:memorygamev2:prod": "cd packages/memorygamev2 && npx vercel deploy --prod"
  },
  "devDependencies": {
    "postcss": "^8.5.3",
    "postcss-preset-env": "^10.1.5"
  }
}
